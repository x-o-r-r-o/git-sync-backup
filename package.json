{
  "name": "vault-sync-github",
  "version": "0.4.0",
  "description": "Obsidian plugin: sync and back up a vault with GitHub on desktop and mobile",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import ./tests/support/register.mjs --test tests/*.test.ts",
    "test:live": "node --import ./tests/support/register.mjs --test --test-concurrency=1 tests/live/live.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
