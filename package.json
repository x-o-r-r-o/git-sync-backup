{
  "name": "vault-sync-git",
  "version": "1.6.0",
  "description": "Obsidian plugin: sync and back up a vault with GitHub on desktop and mobile",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import ./tests/support/register.mjs --test tests/*.test.ts",
    "test:live": "node --import ./tests/support/register.mjs --test --test-concurrency=1 tests/live/live.test.ts",
    "test:hosts": "node --import ./tests/support/register.mjs --test --test-concurrency=1 tests/live/hosts.live.test.ts",
    "lint": "eslint src"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "1.14.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "moment": "^2.31.0"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
